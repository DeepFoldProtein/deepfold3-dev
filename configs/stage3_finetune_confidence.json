{
  "_description": "Stage 3: Fine-tune confidence head. Freeze trunk, enable PAE loss, disable diffusion/distogram losses. Cosine LR schedule.",
  "_usage": "deepfold3 train --data-dir /data/training --output runs/stage3 --config configs/stage3_finetune_confidence.json --params runs/stage2/checkpoint_final.pt",

  "training": {
    "lr": 0.0018,
    "warmup_steps": 1000,
    "finetune_scheduler": "cosine",
    "cosine_max_steps": 20000,
    "cosine_min_lr_ratio": 0.1,

    "max_recycles": 4,
    "diffusion_batch_size": 48,

    "alpha_diffusion": 0.0,
    "alpha_distogram": 0.0,
    "alpha_confidence": 1e-4,
    "alpha_pae": 1.0,
    "alpha_bond": 0.0,

    "skip_load_optimizer": true,
    "skip_load_scheduler": true,
    "train_confidence_only": true,

    "max_steps": 20000,
    "max_checkpoints": 3,
    "dtype": "bf16"
  }
}
