{
  "_description": "Stage 2: Fine-tune structure quality. Bond loss replaces smooth LDDT. Cosine LR schedule. Load from stage 1 checkpoint.",
  "_usage": "deepfold3 train --data-dir /data/training --output runs/stage2 --config configs/stage2_finetune_structure.json --params runs/stage1/checkpoint_final.pt",

  "training": {
    "lr": 0.0018,
    "warmup_steps": 1000,
    "finetune_scheduler": "cosine",
    "cosine_max_steps": 20000,
    "cosine_min_lr_ratio": 0.1,

    "max_recycles": 4,
    "diffusion_batch_size": 48,

    "alpha_diffusion": 4.0,
    "alpha_distogram": 0.03,
    "alpha_confidence": 1e-4,
    "alpha_pae": 0.0,
    "alpha_bond": 1.0,
    "nucleotide_loss_weight": 5.0,
    "ligand_loss_weight": 10.0,

    "skip_load_optimizer": true,
    "skip_load_scheduler": true,
    "train_confidence_only": false,

    "max_steps": 20000,
    "max_checkpoints": 3,
    "dtype": "bf16"
  }
}
