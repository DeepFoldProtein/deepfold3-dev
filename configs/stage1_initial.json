{
  "training": {
    "lr": 0.0018,
    "weight_decay": 0.0,
    "warmup_steps": 1000,
    "start_decay_after": 50000,
    "decay_every": 50000,
    "decay_factor": 0.95,
    "finetune_scheduler": "af3",
    "grad_clip_norm": 10.0,
    "accumulate_grad_batches": 1,
