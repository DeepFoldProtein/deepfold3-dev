      "pair_channel": 128
    },
    "pairformer": {
      "num_layer": 48,
      "pair_channel": 128,
      "seq_channel": 384
    },
    "diffusion": {
      "steps": 200,
      "num_samples": 5,
      "sigma_data": 16.0,
      "p_mean": -1.2,
      "p_std": 1.5
    },
    "confidence": {
      "num_layer": 4,
      "num_plddt_bins": 50,
      "num_distogram_bins": 64,
      "max_error_bin": 31.0
    },
    "template": {
      "num_channels": 64,
      "pairformer": {
        "num_layer": 2
      }
    },
    "data": {
      "max_templates": 4,
      "spatial_crop_prob": 0.5
